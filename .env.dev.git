# GitHub Settings > Environments > development > Environment variables.
# Register these names as GitHub Environment variables, not secrets; replace examples.
# Restrict this Environment to the development branch. No AWS access key is used.
# IAM/OIDC/EC2 setup: docs/deployment.md.
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/traceback-development-deploy
AWS_REGION=ap-northeast-2
ECR_REPOSITORY=traceback
DEVELOPMENT_INSTANCE_ID=i-replace-with-development-instance-id

# EC2 runtime variable inventory: config/server.env.example.
