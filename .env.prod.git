# GitHub Settings > Environments > production > Environment variables.
# Register these names as GitHub Environment variables, not secrets; replace examples.
# Restrict this Environment to main and require reviewer approval before deployment.
# IAM/OIDC/EC2 setup: docs/deployment.md.
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/traceback-production-deploy
AWS_REGION=ap-northeast-2
ECR_REPOSITORY=traceback
PRODUCTION_INSTANCE_ID=i-replace-with-production-instance-id

# Both environments must point to the same ECR repository and AWS account/Region
# so production can pull the exact image that development deployed.
# EC2 runtime variable inventory: config/server.env.example.
