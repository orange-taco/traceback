# Public template only. Never place real credentials in this file.
# Each environment keeps its own untracked `.env` with the same variable contract.
POSTGRES_DB=traceback
POSTGRES_USER=traceback
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://user:password@database-host:5432/traceback
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
