# Public template only. Never place real credentials in this file.
# Each environment keeps its own untracked `.env` with the same variable contract.
# The Compose app reaches PostgreSQL through the service name. Host-run Django
# uses localhost:15432 instead, as shown in README.md.
TRACEBACK_DATABASE_URL=postgresql://traceback:development-only@db:5432/traceback
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local
FRONTEND_BASE_URL=http://localhost:5173

# Local development prints email messages to the application terminal.
DEFAULT_FROM_EMAIL=no-reply@localhost

# Production/development environments use AWS SES SMTP instead.
# Replace these values with SES credentials and a verified sender.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true

# Kakao Login. Leave empty only when Kakao Login is disabled.
KAKAO_REST_API_KEY=development-only-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
# Required for server-side Kakao unlink on account deletion/disconnect.
KAKAO_ADMIN_KEY=

# Local Docker Compose PostgreSQL defaults.
TRACEBACK_POSTGRES_DB=traceback
TRACEBACK_POSTGRES_USER=traceback
TRACEBACK_POSTGRES_PASSWORD=development-only
TRACEBACK_POSTGRES_PORT=15432
