# Public template only. Never place real credentials in this file.
# Each environment keeps its own untracked `.env` with the same variable contract.
# Host-run Django uses this URL to reach the Docker Compose PostgreSQL service
# published on localhost.
DATABASE_URL=postgresql://traceback:development-only@localhost:5432/traceback
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Docker Compose PostgreSQL defaults.
POSTGRES_DB=traceback
POSTGRES_USER=traceback
POSTGRES_PASSWORD=development-only
POSTGRES_PORT=5432
